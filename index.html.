<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Enzymes in Chemistry</title>
<link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600&family=Nunito:wght@500;700&family=Orbitron:wght@600;800&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#f2faff; --bg2:#dff2fc; --ink:#0f2a43; --muted:#4a6680; --card:#ffffff; --line:#c5e3f4;
  --accent:#1f78d1; --accent-ink:#ffffff; --pop:#ff6b5e; --hero:#a9def2;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px); padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){--bg:#0b1c2e; --bg2:#10283f; --ink:#e8f5fd; --muted:#9bb7cc; --card:#142f49; --line:#244a6b; --accent:#5fb0f5; --accent-ink:#06192b; --pop:#ff8a7d; --hero:#12324f;}
}
:root[data-theme="dark"]{--bg:#0b1c2e; --bg2:#10283f; --ink:#e8f5fd; --muted:#9bb7cc; --card:#142f49; --line:#244a6b; --accent:#5fb0f5; --accent-ink:#06192b; --pop:#ff8a7d; --hero:#12324f;}
html{scroll-behavior:smooth;scroll-padding-top:calc(env(safe-area-inset-top,0px) + 76px)}
*,*::before,*::after{box-sizing:inherit}
body{margin:0;background:var(--bg);color:var(--ink);font-family:"Nunito",system-ui,sans-serif;font-size:1.1rem;line-height:1.65}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);background:var(--card);z-index:30}
h1,h2,h3{font-family:"Fredoka",system-ui,sans-serif;font-weight:600;line-height:1.1;margin:0 0 .4em}
h1{font-size:clamp(3.2rem,10vw,6.5rem)}
h2{font-size:clamp(2rem,5vw,3.2rem)}
h3{font-size:1.45rem}
p{margin:0 0 1em;max-width:40em}
sub{font-size:.72em;line-height:0;vertical-align:baseline;position:relative;bottom:-.25em}
.wrap{max-width:1080px;margin:0 auto;padding:0 22px}
section{padding:clamp(56px,10vw,110px) 0}
.alt{background:var(--bg2)}
.lead{font-size:1.25rem;color:var(--muted)}
svg.i{width:26px;height:26px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;flex:none}

/* header */
header{position:sticky;top:env(safe-area-inset-top,0px);z-index:40;background:var(--card);border-bottom:1px solid var(--line)}
.theme-toggle-row{max-width:1080px;margin:0 auto;padding:8px 22px 0;display:flex;justify-content:flex-end;height:42px}
.bar{display:flex;align-items:center;justify-content:space-between;height:64px}
.logo{font-family:"Fredoka",sans-serif;font-weight:600;font-size:1.35rem;color:var(--ink);text-decoration:none;display:flex;align-items:center;gap:8px}
.logo svg{color:var(--pop)}
nav ul{list-style:none;display:flex;gap:6px;margin:0;padding:0}
nav a{display:block;padding:8px 14px;border-radius:99px;color:var(--ink);text-decoration:none;font-weight:700;font-size:1rem}
nav a:hover{background:var(--bg2)}
nav a.on{background:var(--accent);color:var(--accent-ink)}
#menu{display:none;background:none;border:1px solid var(--line);color:var(--ink);border-radius:10px;width:44px;height:44px;cursor:pointer;align-items:center;justify-content:center}
.theme-toggle{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:9px 14px;border:1px solid var(--line);border-radius:999px;background:var(--bg2);color:var(--ink);font:700 .95rem "Nunito",sans-serif;cursor:pointer;white-space:nowrap}
.theme-toggle:hover{filter:brightness(.96)}
a:focus-visible,button:focus-visible{outline:3px solid var(--pop);outline-offset:2px}
@media (max-width:760px){
  #menu{display:flex}
  nav{position:absolute;left:0;right:0;top:106px;background:var(--card);border-bottom:1px solid var(--line);display:none;padding:10px 16px 16px}
  nav.open{display:block}
  nav ul{flex-direction:column}
  nav a{padding:12px 14px}
}

/* buttons */
.btns{display:flex;flex-wrap:wrap;gap:12px;margin-top:1.4em}
.btn{display:inline-flex;align-items:center;gap:8px;padding:14px 26px;border-radius:99px;font-weight:700;text-decoration:none;font-size:1.05rem;background:var(--accent);color:var(--accent-ink);border:2px solid var(--accent)}
.btn.ghost{background:transparent;color:var(--ink);border-color:var(--ink)}
.btn:hover{filter:brightness(1.08)}

/* hero */
.hero{background:var(--hero);padding:clamp(48px,9vw,100px) 0}
.hero .wrap{display:grid;grid-template-columns:1.1fr .9fr;gap:40px;align-items:center}
.hero p.lead{color:var(--ink);opacity:.85}
.by{display:inline-flex;align-items:center;gap:10px;background:var(--card);border-radius:99px;padding:8px 18px;font-weight:700;font-size:1rem}
.art{width:100%;max-width:440px;justify-self:center}
@media (max-width:820px){.hero .wrap{grid-template-columns:1fr}.art{max-width:320px}}

/* cards */
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:22px;margin-top:2em}
.card{background:var(--card);border:1px solid var(--line);border-radius:22px;padding:28px}
.card p{margin:0;color:var(--muted)}
.ico{width:54px;height:54px;border-radius:16px;background:var(--accent);color:var(--accent-ink);display:flex;align-items:center;justify-content:center;margin-bottom:16px}
.ico.pop{background:var(--pop);color:#fff}
.two{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:start}
@media (max-width:820px){.two{grid-template-columns:1fr}}

/* reaction */
.steps{display:flex;align-items:stretch;gap:10px;margin:2em 0 1em;flex-wrap:wrap}
.step{flex:1 1 170px;background:var(--card);border:1px solid var(--line);border-radius:18px;padding:18px;text-align:center}
.step b{display:block;font-family:"Fredoka",sans-serif;font-size:1.3rem}
.step span{color:var(--muted);font-size:.95rem}
.arrow{align-self:center;font-size:1.8rem;color:var(--pop);font-weight:700}
@media (max-width:640px){.arrow{display:none}}
.formula{display:inline-block;background:var(--card);border-left:6px solid var(--pop);border-radius:12px;padding:12px 20px;font-family:"Fredoka",sans-serif;font-size:clamp(1.15rem,3vw,1.7rem);margin:.4em 0 1em}

/* deep dive */
.feature{display:grid;grid-template-columns:auto 1fr;gap:22px;background:var(--card);border:1px solid var(--line);border-radius:26px;padding:clamp(22px,4vw,38px);margin-top:24px}
.feature .ico{width:72px;height:72px;border-radius:22px;margin:0}
.feature ul{margin:0;padding:0;list-style:none}
.feature li{padding:10px 0 10px 28px;position:relative;border-top:1px solid var(--line)}
.feature li:first-child{border-top:0}
.feature li::before{content:"";position:absolute;left:0;top:1.05em;width:12px;height:12px;border-radius:50%;background:var(--pop)}
@media (max-width:640px){.feature{grid-template-columns:1fr}}

/* summary + footer */
.take{counter-reset:t}
.take .card{position:relative}
footer{background:var(--ink);color:#e8f5fd;text-align:center;padding:64px 0 48px}
footer h2{margin-bottom:.2em}
footer p{margin:0 auto 1.2em;color:#a9c7dd}
footer .btn{background:#fff;color:#0f2a43;border-color:#fff}
.step{transition:border-color .3s,background .3s}
.step.on{border-color:var(--pop);border-width:2px;background:var(--bg2)}
.viz-sec{padding-top:0}
.viz{padding:clamp(20px,4vw,36px)}
.viz p.cap{min-height:3.3em;color:var(--ink)}
#vizsvg{width:100%;height:auto;display:block;margin:10px 0;color:var(--ink)}
#vizsvg .sub{transform:translate(470px,130px);transition:transform 1s ease}
#vizsvg[data-stage="1"] .sub,#vizsvg[data-stage="2"] .sub{transform:translate(202px,130px)}
#vizsvg .pa,#vizsvg .pb{transition:transform 1s ease .2s}
#vizsvg[data-stage="2"] .pa{transform:translate(150px,-70px)}
#vizsvg[data-stage="2"] .pb{transform:translate(150px,70px)}
#vizsvg .site,#vizsvg .ts{transition:opacity .4s}
#vizsvg:not([data-stage="0"]) .site,#vizsvg:not([data-stage="0"]) .ts{opacity:0}
.btn{cursor:pointer;font-family:inherit}
.btn:disabled{opacity:.4;cursor:default}
.qhead{color:var(--muted);font-weight:700;margin-bottom:.4em}
.opt{display:block;width:100%;text-align:left;padding:14px 18px;margin:10px 0;border-radius:14px;border:2px solid var(--line);background:var(--bg);color:var(--ink);font:inherit;cursor:pointer}
.opt:hover:not(:disabled){border-color:var(--accent)}
.opt:disabled{cursor:default}
.opt.ok{border-color:#2e9e5b;background:#2e9e5b24}
.opt.no{border-color:var(--pop);background:#ff6b5e24}
.fb{margin:14px 0 0;font-weight:700}
.score{font-family:"Fredoka",sans-serif;font-size:clamp(2.4rem,7vw,4rem);margin:0}

/* Calm green, cream and warm accent palette */
:root{--bg:#f5f8f6;--bg2:#e8f1ed;--ink:#203b36;--muted:#526d66;--card:#fff;--line:#d2e1da;--accent:#477d70;--accent-ink:#fff;--pop:#d99a62;--hero:#dcebe4}
html{scroll-behavior:smooth}
body{background:var(--bg);color:var(--ink)}
header{background:var(--card);backdrop-filter:none}
body::before{background:var(--card)}
nav{background:var(--card)}
.hero{background:var(--hero)}
h1,h2,h3,.logo{font-family:"Nunito",system-ui,sans-serif;font-weight:800}
h2{text-shadow:none}
h2::after{content:"";display:block;width:52px;height:4px;margin-top:12px;border-radius:4px;background:var(--pop)}
.glitch{animation:none;text-shadow:none}
.art{animation:none;filter:none}
.card,.feature,.step,.by{backdrop-filter:none}
.card,.feature,.step{transition:transform .25s ease,border-color .25s ease,box-shadow .25s ease}
.card:hover,.feature:hover{border-color:var(--accent);box-shadow:0 6px 18px #203b3610}
.btn{box-shadow:none;transition:transform .2s,background .2s}
.btn:hover:not(:disabled){transform:translateY(-2px);box-shadow:none}
.btn.ghost{box-shadow:none;border-color:var(--accent);color:var(--ink)}
.formula{background:var(--bg2);box-shadow:none;color:var(--ink)}
.rv{opacity:1;transform:none}
footer{background:#203b36;color:#fff;border-top:1px solid var(--line)}
footer p{color:#e0ece6}
.protein-figure{display:block;width:100%;max-width:300px;height:auto;margin:18px auto 8px}
.protein-caption{text-align:center;color:var(--muted);font-size:.88rem;margin:0 auto 8px}
.protein-figure .strand{stroke-dasharray:360;stroke-dashoffset:0;transition:stroke-dashoffset 1s ease}
.feature:hover .protein-figure .strand{stroke-dashoffset:24}
.game-card{max-width:760px;margin-top:24px}
.game-options{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin:18px 0}
.game-options .opt{margin:0;text-align:center}
.opt{display:block;width:100%;text-align:left;padding:14px 18px;margin:10px 0;border-radius:14px;border:2px solid var(--line);background:var(--bg);color:var(--ink);font:inherit;cursor:pointer}
.opt:hover:not(:disabled){border-color:var(--accent)}
.opt:disabled{cursor:default;opacity:1}
.opt.ok{border-color:#2e9e5b;background:#2e9e5b18}
.opt.no{border-color:var(--pop);background:#d99a6218}
.fb{margin:14px 0 0;font-weight:700}
.game-score{color:var(--muted);font-weight:800;margin-top:14px}
@media(max-width:620px){.game-options{grid-template-columns:1fr}}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;transition:none!important;animation:none!important}}


/* Professional website refinement */
:root{
  --bg:#f7f9f8;
  --bg2:#edf3f0;
  --ink:#1d332e;
  --muted:#60736d;
  --card:#ffffff;
  --line:#dce6e1;
  --accent:#356b5d;
  --accent-ink:#ffffff;
  --pop:#c58b58;
  --hero:#e7f0eb;
}
html{scroll-padding-top:90px}
body{
  font-family:Inter,"Segoe UI",Arial,sans-serif;
  font-size:16px;
  line-height:1.75;
  letter-spacing:.005em;
  background:var(--bg);
}
.wrap{max-width:1160px;padding-left:28px;padding-right:28px}
header{
  background:rgba(255,255,255,.94);
  border-bottom:1px solid var(--line);
  box-shadow:0 3px 18px rgba(29,51,46,.045);
  backdrop-filter:blur(14px);
}
.bar{height:76px}
.logo{
  font-family:Inter,"Segoe UI",Arial,sans-serif;
  font-size:1.12rem;
  font-weight:800;
  letter-spacing:-.035em;
}
.logo svg{color:var(--accent)}
nav ul{gap:2px}
nav a{
  font-size:.88rem;
  font-weight:650;
  color:#435b53;
  padding:9px 11px;
  border-radius:8px;
  transition:background .2s,color .2s;
}
nav a:hover{background:#edf3f0;color:var(--accent)}
nav a.on{background:var(--accent);color:white}
h1,h2,h3,.logo,.step b,.formula,.score{
  font-family:Inter,"Segoe UI",Arial,sans-serif;
  letter-spacing:-.045em;
}
h1{
  max-width:720px;
  font-size:clamp(3.6rem,8vw,6.2rem);
  line-height:.98;
  font-weight:800;
  letter-spacing:-.075em;
}
h2{
  font-size:clamp(1.9rem,4vw,2.7rem);
  line-height:1.12;
  font-weight:760;
  letter-spacing:-.055em;
  margin-bottom:22px;
}
h2::after{width:38px;height:3px;margin-top:16px}
h3{font-size:1.22rem;font-weight:750;letter-spacing:-.025em}
p{max-width:68ch}
.lead{font-size:1.15rem;line-height:1.65;color:#536b62}
section{padding:clamp(68px,8vw,104px) 0}
.hero{
  position:relative;
  overflow:hidden;
  background:linear-gradient(120deg,#edf4f0 0%,#e2eee8 60%,#dce9e2 100%);
  padding:clamp(76px,10vw,128px) 0;
}
.hero .wrap{grid-template-columns:1.1fr .9fr;gap:64px}
.hero .lead{max-width:570px;color:#536b62;opacity:1}
.hero .by{
  background:#fff;
  color:#426257;
  border:1px solid #d8e5de;
  border-radius:6px;
  padding:7px 12px;
  font-size:.72rem;
  font-weight:800;
  letter-spacing:.11em;
}
.hero .by svg{width:18px;height:18px}
.hero .term{color:#557168;font-size:.92rem;min-height:1.5em}
.hero .wrap>div>p:not(.by):not(.lead):not(.term){color:#718078;font-size:.9rem}
.art{max-width:430px}
.btns{gap:12px;margin-top:30px}
.btn{
  border-radius:8px;
  padding:12px 19px;
  font-size:.92rem;
  font-weight:750;
  box-shadow:none;
}
.btn.ghost{background:transparent;border:1px solid #9db5aa;color:#315d50}
.btn:hover:not(:disabled){transform:translateY(-2px);filter:none;box-shadow:0 7px 18px rgba(29,51,46,.09)}
.card,.feature,.step{
  border:1px solid var(--line);
  border-radius:14px;
  box-shadow:0 5px 20px rgba(29,51,46,.035);
}
.card{padding:30px}
.card:hover,.feature:hover{
  transform:translateY(-3px);
  border-color:#b7cec2;
  box-shadow:0 12px 28px rgba(29,51,46,.07);
}
.ico{border-radius:12px;background:#e7f0eb;color:#356b5d}
.ico.pop{background:#f4e9de;color:#98683f}
.two{gap:64px}
.steps{gap:14px}
.step{border-radius:12px;padding:22px;background:#fff}
.step b{font-size:1.12rem;font-weight:750}
.step span{font-size:.88rem;color:var(--muted)}
.arrow{color:var(--accent)}
.formula{
  border-left:3px solid var(--pop);
  border-radius:8px;
  padding:13px 18px;
  font-size:1.12rem;
}
.feature{
  border-radius:16px;
  padding:clamp(24px,4vw,38px);
  gap:28px;
}
.feature .ico{width:60px;height:60px;border-radius:14px}
.feature li{font-size:.97rem;padding:12px 0 12px 25px}
.feature li::before{width:8px;height:8px;top:1.55em;background:var(--pop)}
.protein-figure{max-width:280px}
.protein-caption{font-size:.82rem}
.game-card{max-width:820px}
.opt{
  border:1px solid var(--line);
  border-radius:9px;
  background:#fff;
  padding:13px 16px;
  font-size:.96rem;
  transition:border-color .2s,background .2s,transform .2s;
}
.opt:hover:not(:disabled){border-color:var(--accent);background:#f5f9f6;transform:translateY(-1px)}
.opt.ok{border-color:#4b8a69;background:#edf6ef}
.opt.no{border-color:#c58b58;background:#fbf2e9}
.qhead{font-size:.88rem;letter-spacing:.02em}
.game-score{font-size:.9rem}
.score{font-weight:800;letter-spacing:-.06em}
footer{
  background:#1d332e;
  padding:68px 0 56px;
  text-align:left;
}
footer .wrap{max-width:1160px}
footer h2{font-size:2rem}
footer h2::after{display:none}
footer p{margin-left:0;color:#c4d3cc}
footer .btn{background:#fff;color:#1d332e;border-color:#fff}
.alt{background:#edf3f0}
#menu{border-radius:8px}
@media(max-width:760px){
  .wrap{padding-left:20px;padding-right:20px}
  .bar{height:68px}
  nav{top:68px}
  .hero .wrap{grid-template-columns:1fr;gap:34px}
  .hero{padding:70px 0}
  .art{max-width:300px}
  .two{gap:24px}
  nav a{font-size:.95rem}
}
@media(min-width:761px){
  nav a{white-space:nowrap}
}


/* Enzyme matching game */
.game-topline{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}
.game-topline p{margin:0}
.game-status{margin:12px 0 20px;padding:12px 15px;border-radius:9px;background:var(--bg2);color:var(--ink);font-weight:700}
.match-layout{display:grid;grid-template-columns:.8fr 1.2fr;gap:24px}
.match-column h3{margin-bottom:12px}
.enzyme-pieces,.match-targets{display:grid;gap:10px}
.enzyme-piece,.match-target{width:100%;border:1px solid var(--line);border-radius:10px;background:#fff;color:var(--ink);font:inherit;text-align:left;padding:13px 15px}
.enzyme-piece{font-weight:800;cursor:grab;box-shadow:0 3px 10px rgba(29,51,46,.04);transition:transform .15s,border-color .15s,background .15s}
.enzyme-piece:hover,.enzyme-piece.selected{border-color:var(--accent);background:#edf5f0;transform:translateY(-1px)}
.enzyme-piece:active{cursor:grabbing}
.enzyme-piece.used{opacity:.38;cursor:default;text-decoration:line-through;transform:none}
.match-target{min-height:76px;display:flex;align-items:center;justify-content:space-between;gap:12px;cursor:pointer;transition:border-color .15s,background .15s}
.match-target.drag-over{border:2px dashed var(--accent);background:#edf5f0}
.match-target.matched{border-color:#4b8a69;background:#edf6ef;cursor:default}
.target-copy{font-weight:650;line-height:1.4}
.target-result{flex:none;color:var(--muted);font-size:.78rem;font-weight:750;text-align:right}
.match-target.matched .target-result{color:#36734f}
.game-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:20px}
.game-finish{margin:16px 0 0;padding:15px;border-radius:10px;background:#edf6ef;color:#285a3b;font-weight:800}
@media(max-width:760px){.match-layout{grid-template-columns:1fr}.match-target{min-height:68px}}


/* Temperature experiment */
.temp-panel{display:grid;grid-template-columns:1fr 1fr;gap:26px;align-items:stretch;margin-top:24px}
.temp-control{background:#fff;border:1px solid var(--line);border-radius:14px;padding:26px}
.temp-reading{font-size:2.3rem;font-weight:800;letter-spacing:-.05em;line-height:1.1}
.temp-control input[type=range]{width:100%;accent-color:var(--accent);margin:14px 0 8px}
.temp-presets{display:flex;flex-wrap:wrap;gap:8px;margin:6px 0 18px}
.temp-presets .btn{padding:8px 14px;font-size:.85rem}
.activity-track{height:14px;background:#e3ebe6;border-radius:99px;overflow:hidden;margin:12px 0 8px}
.activity-fill{height:100%;width:0;border-radius:99px;background:var(--accent);transition:width .25s}
.denature-stage{min-height:240px;border:1px solid var(--line);border-radius:14px;padding:18px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;background:#fff;transition:background .3s}
.protein-shape{width:min(260px,85%);height:auto;overflow:visible}
.chart-card{margin-top:24px;padding:22px}
#tempChart{width:100%;height:auto;display:block;color:var(--ink);touch-action:pan-y;cursor:crosshair;user-select:none}
#tempChart text{fill:currentColor;font-size:13px;font-family:inherit}
.temp-note{color:var(--muted);font-size:.92rem}
@media(max-width:760px){.temp-panel{grid-template-columns:1fr}}

/* Interactive enzyme conditions explorer */
.condition-explorer{margin:34px 0;padding:clamp(20px,4vw,34px);border:1px solid var(--line);border-radius:24px;background:var(--card);box-shadow:0 8px 28px #203b360b}
.condition-explorer .enzyme-tabs{display:flex;flex-wrap:wrap;gap:10px;margin:18px 0}
.condition-explorer .enzyme-tab{border:2px solid var(--line);border-radius:999px;padding:10px 18px;background:var(--bg);color:var(--ink);font:inherit;font-weight:800;cursor:pointer}
.condition-explorer .enzyme-tab[aria-pressed="true"]{background:var(--ink);color:white;border-color:var(--ink)}
.condition-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}
.condition-control,.condition-result{padding:20px;border:1px solid var(--line);border-radius:18px;background:var(--bg)}
.condition-control label{display:flex;justify-content:space-between;gap:12px;font-weight:800}
.condition-control input[type=range]{width:100%;accent-color:var(--accent);margin:18px 0 8px}
.condition-value{font-family:"Nunito",sans-serif;font-size:1.5rem;font-weight:900;color:var(--accent)}
.condition-meter{height:14px;border-radius:99px;background:var(--line);overflow:hidden;margin:12px 0}
.condition-meter span{display:block;height:100%;width:0;background:var(--accent);border-radius:99px;transition:width .25s}
.condition-result h3{margin:0 0 8px}
.condition-status{font-weight:900;font-size:1.1rem}
.condition-facts{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:14px}
.condition-fact{padding:12px;border-radius:12px;background:var(--card)}
.condition-fact small{display:block;color:var(--muted)}
.condition-note{font-size:.92rem;color:var(--muted);margin:12px 0 0}
@media(max-width:680px){.condition-grid{grid-template-columns:1fr}.condition-facts{grid-template-columns:1fr 1fr}}
@media(prefers-reduced-motion:reduce){.condition-meter span{transition:none}}


