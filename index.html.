(function(){
  var Q=[
   {q:'Which enzyme breaks down hydrogen peroxide into water and oxygen?',o:['Catalase','Pepsin','Lysozyme','Amylase'],a:0,e:'Catalase converts hydrogen peroxide into water and oxygen.'},
   {q:'Where does pepsin work?',o:['In the stomach','In tears','In the mouth','In liver cells'],a:0,e:'Pepsin is a digestive enzyme that works in the acidic environment of the stomach.'},
   {q:'What part of bacteria does lysozyme attack?',o:['The cell wall','The nucleus','The mitochondria','The cell membrane of human cells'],a:0,e:'Lysozyme breaks bonds in peptidoglycan, a material in bacterial cell walls.'},
   {q:'Which enzyme breaks down starch?',o:['Amylase','Lipase','Protease','Catalase'],a:0,e:'Amylase breaks starch into smaller sugars.'},
   {q:'Why is catalase important for cells?',o:['It breaks down harmful hydrogen peroxide','It makes proteins in the stomach','It breaks down fats in food','It builds bacterial cell walls'],a:0,e:'Hydrogen peroxide can harm cells, and catalase converts it into water and oxygen.'}
