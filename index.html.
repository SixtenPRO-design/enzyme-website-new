<script>
(function(){
  var game = document.getElementById('enzyme-game');
  if (!game) return;
  var piecesBox = document.getElementById('enzyme-pieces');
  var targets = Array.prototype.slice.call(game.querySelectorAll('.match-target'));
  var pieces = Array.prototype.slice.call(game.querySelectorAll('.enzyme-piece'));
  var progress = document.getElementById('game-progress');
  var score = document.getElementById('game-score');
  var feedback = document.getElementById('game-feedback');
  var finish = document.getElementById('game-finish');
  var restart = document.getElementById('game-restart');
  var selected = null, matched = 0, mistakes = 0;

  function shufflePieces(){
    for (var i = pieces.length - 1; i > 0; i--) {
      var j = Math.floor(Math.random() * (i + 1));
      var temp = pieces[i]; pieces[i] = pieces[j]; pieces[j] = temp;
    }
    pieces.forEach(function(piece){ piecesBox.appendChild(piece); });
  }
  function updateStats(){
    progress.textContent = matched + ' of ' + targets.length + ' matches';
    score.textContent = 'Mistakes: ' + mistakes;
  }
  function clearSelection(){
    selected = null;
    pieces.forEach(function(piece){ piece.classList.remove('selected'); });
  }
  function place(enzyme, target){
    if (!enzyme || target.classList.contains('matched') || enzyme.classList.contains('used')) return;
    if (target.getAttribute('data-answer') === enzyme.getAttribute('data-enzyme')) {
      target.classList.add('matched');
      target.querySelector('.target-result').textContent = enzyme.textContent + ' ✓';
      enzyme.classList.add('used');
      enzyme.setAttribute('aria-disabled','true');
      enzyme.draggable = false;
      matched++;
      feedback.textContent = 'Correct match! ' + enzyme.textContent + ' has the right job.';
      clearSelection();
      updateStats();
      if (matched === targets.length) {
        finish.hidden = false;
        finish.textContent = 'All six matches completed! You made ' + mistakes + ' mistake' + (mistakes === 1 ? '' : 's') + '. Great work.';
        feedback.textContent = 'Game complete!';
      }
    } else {
      mistakes++;
      updateStats();
      feedback.textContent = 'Not a match yet. Try another job for ' + enzyme.textContent + '.';
      target.classList.remove('drag-over');
    }
  }
  pieces.forEach(function(piece){
    piece.addEventListener('dragstart', function(event){
      if (piece.classList.contains('used')) { event.preventDefault(); return; }
      event.dataTransfer.setData('text/plain', piece.getAttribute('data-enzyme'));
      event.dataTransfer.effectAllowed = 'move';
      selected = piece;
    });
    piece.addEventListener('dragend', function(){
      targets.forEach(function(target){ target.classList.remove('drag-over'); });
    });
    piece.addEventListener('click', function(){
      if (piece.classList.contains('used')) return;
      if (selected === piece) { clearSelection(); feedback.textContent = 'Selection cleared.'; return; }
      clearSelection(); selected = piece; piece.classList.add('selected');
      feedback.textContent = 'Now tap the job that matches ' + piece.textContent + '.';
    });
  });
  targets.forEach(function(target){
    target.addEventListener('dragover', function(event){
      if (target.classList.contains('matched')) return;
      event.preventDefault(); target.classList.add('drag-over');
    });
    target.addEventListener('dragleave', function(){ target.classList.remove('drag-over'); });
    target.addEventListener('drop', function(event){
      event.preventDefault(); target.classList.remove('drag-over');
      var key = event.dataTransfer.getData('text/plain');
      var dragged = pieces.find(function(piece){ return piece.getAttribute('data-enzyme') === key; });
      place(dragged || selected, target);
    });
    target.addEventListener('click', function(){
      if (selected) place(selected, target);
      else if (!target.classList.contains('matched')) feedback.textContent = 'Tap an enzyme first, then tap this job.';
    });
  });
  restart.addEventListener('click', function(){
    matched = 0; mistakes = 0; clearSelection(); finish.hidden = true; finish.textContent = '';
    pieces.forEach(function(piece){ piece.classList.remove('used'); piece.removeAttribute('aria-disabled'); piece.draggable = true; });
    targets.forEach(function(target){
      target.classList.remove('matched','drag-over');
      target.querySelector('.target-result').textContent = 'Drop enzyme here';
    });
    shufflePieces(); updateStats(); feedback.textContent = 'New round! Match all six enzymes to their jobs.';
  });
  shufflePieces(); updateStats();
})();
</script>


<script>
(function(){
  var $=function(id){return document.getElementById(id)};
  var slider=$('tempSlider'); if(!slider)return;
  var val=$('tempValue'),fill=$('activityFill'),bar=$('activityBar'),label=$('activityLabel'),pct=$('activityPct'),explain=$('tempExplanation'),stage=$('denatureStage'),sLabel=$('shapeLabel'),sText=$('shapeText'),back=$('enzBack'),site=$('enzSite'),sub=$('enzSub'),chart=$('tempChart'),curve=$('cCurve'),area=$('cArea'),cur=$('cCursor'),dot=$('cDot'),read=$('cRead'),sweep=$('tempSweep');
  var TM=50,W=3,X0=60,XS=5.5,Y0=260,YS=2.4;
  function nat(t){return 1/(1+Math.exp((t-TM)/W))}
  function act(t){var a=t<=37?Math.pow(2,(t-37)/10):nat(t)/nat(37);return Math.max(0,Math.min(1,a))*100}
  function cx(t){return X0+t*XS}
  function cy(a){return Y0-a*YS}
  var d='';for(var i=0;i<=100;i++){d+=(i?'L':'M')+cx(i).toFixed(1)+' '+cy(act(i)).toFixed(1)}
  curve.setAttribute('d',d);
  area.setAttribute('d',d+'L'+cx(100)+' '+Y0+'L'+cx(0)+' '+Y0+'Z');
  var BF=[8,56,15,18,42,14,55,43,68,73,83,82,99,48,114,17,137,22,143,49,150,78,171,83,184,48];
  var BU=[6,34,28,2,38,96,62,70,86,40,98,104,126,64,148,34,160,98,186,78];
  BU=[6,34,28,2,38,96,62,70,86,40,98,104,126,64,148,34,160,98,186,78,170,100,176,90,186,94];
  var SF=[76,46,95,70,114,46],SU=[68,62,95,46,122,62];
  function lerp(a,b,m){return a.map(function(v,k){return v+(b[k]-v)*m})}
  function pc(a){var p='M'+a[0].toFixed(1)+' '+a[1].toFixed(1);for(var k=2;k<a.length;k+=6){p+=' C'+a.slice(k,k+6).map(function(v){return v.toFixed(1)}).join(' ')}return p}
  function pq(a){return 'M'+a[0].toFixed(1)+' '+a[1].toFixed(1)+' Q'+a.slice(2).map(function(v){return v.toFixed(1)}).join(' ')}
  function mix(a,b,m){return 'rgb('+a.map(function(v,k){return Math.round(v+(b[k]-v)*m)}).join(',')+')'}
  var GREEN=[53,107,93],RED=[181,55,55],WHITE=[255,255,255],COLD=[222,236,251],HOT=[255,190,190];
  function update(){
    var t=+slider.value,a=act(t),m=Math.max(0,Math.min(1,(1-nat(t)-.02)/.96));
    var L,E;
    if(t<15){L='Very low activity (too cold)';E='Particles move slowly, so enzyme and substrate rarely collide. The enzyme keeps its shape and speeds up again when it warms.'}
    else if(t<32){L='Activity rising';E='Warmer particles move faster, so there are more collisions between enzyme and substrate and more successful reactions.'}
    else if(t<=42){L='Maximum activity (optimum)';E='Near the optimum temperature, collisions are frequent and the active site has exactly the right shape.'}
    else if(t<=50){L='Activity falling';E='Heat starts to break the weak bonds holding the enzyme in shape. The active site begins to change, so fewer substrates fit.'}
    else if(t<=60){L='Mostly denatured';E='Most enzyme molecules have lost their shape. The substrate rarely fits, so the reaction almost stops.'}
    else{L='Fully denatured: no activity';E='The active site is destroyed. Denaturation is permanent, so cooling the enzyme down will not bring it back.'}
    val.textContent=t;
    slider.setAttribute('aria-valuetext',t+' degrees Celsius');
    label.textContent=L;pct.textContent='('+Math.round(a)+'% of maximum)';explain.textContent=E;
    fill.style.width=a+'%';fill.style.background=mix(GREEN,RED,m);
    bar.setAttribute('aria-valuenow',Math.round(a));
    back.setAttribute('d',pc(lerp(BF,BU,m)));
    site.setAttribute('d',pq(lerp(SF,SU,m)));
    back.setAttribute('stroke',mix(GREEN,RED,m));
    sub.setAttribute('cx',95+65*m);sub.setAttribute('cy',50-32*m);
    stage.style.background=t<37?mix(WHITE,COLD,(37-t)/37):mix(WHITE,HOT,(t-37)/63);
    if(m>.7){sLabel.textContent='Denatured enzyme';sText.textContent='The active site has lost its shape. The substrate cannot bind.'}
    else if(m>.12){sLabel.textContent='Starting to denature';sText.textContent='The shape is changing, so the substrate fits less well.'}
    else if(t<15){sLabel.textContent='Normal shape, but slow';sText.textContent='The substrate fits, but collisions are rare because it is cold.'}
    else{sLabel.textContent='Normal enzyme shape';sText.textContent='The substrate fits into the active site.'}
    var x=cx(t),y=cy(a);
    cur.setAttribute('x1',x);cur.setAttribute('x2',x);
    dot.setAttribute('cx',x);dot.setAttribute('cy',y);
    read.textContent=t+'°C · '+Math.round(a)+'%';
    read.setAttribute('x',x>480?x-12:x+12);read.setAttribute('text-anchor',x>480?'end':'start');
    read.setAttribute('y',Math.max(16,y-12));
  }
  var timer=null;
  function stop(){if(timer){clearInterval(timer);timer=null;sweep.textContent='▶ Heat it up'}}
  function setT(t){slider.value=Math.max(0,Math.min(100,t));update()}
  slider.addEventListener('input',function(){stop();update()});
  [].forEach.call(document.querySelectorAll('.temp-presets [data-t]'),function(b){b.addEventListener('click',function(){stop();setT(+b.getAttribute('data-t'))})});
  sweep.addEventListener('click',function(){
    if(timer){stop();return}
    if(+slider.value>=100)setT(0);
    sweep.textContent='❚❚ Pause';
    timer=setInterval(function(){var t=+slider.value+1;setT(t);if(t>=100)stop()},90);
  });
  var drag=false;
  function fromEvent(e){var r=chart.getBoundingClientRect();stop();setT(Math.round(((e.clientX-r.left)/r.width*640-X0)/XS))}
  chart.addEventListener('pointerdown',function(e){drag=true;try{chart.setPointerCapture(e.pointerId)}catch(x){}fromEvent(e)});
  chart.addEventListener('pointermove',function(e){if(drag)fromEvent(e)});
  chart.addEventListener('pointerup',function(){drag=false});
  chart.addEventListener('pointercancel',function(){drag=false});
  update();
})();
</script>

<script>
(function(){
  const root = document.getElementById('conditionExplorer');
  if (!root) return;

  const enzymes = {
    pepsin: {
      name: 'Pepsin',
      ph: 2,
      phLabel: 'About 2',
      where: 'Where it works: the stomach, where hydrochloric acid creates a very acidic environment.',
      phText: 'Pepsin works best in the strongly acidic environment of the stomach.'
    },
    catalase: {
      name: 'Catalase',
      ph: 7,
      phLabel: 'About 7 (neutral)',
      where: 'Where it works: in many cells, where it helps break down hydrogen peroxide into water and oxygen.',
      phText: 'Catalase usually works best around neutral pH in human cells.'
    },
    lysozyme: {
      name: 'Lysozyme',
      ph: 6.5,
      phLabel: 'Around 6–7',
      where: 'Where it works: in body fluids such as tears and saliva, where it helps protect against bacteria.',
      phText: 'Lysozyme generally works well around slightly acidic to neutral pH; its exact optimum can vary.'
    }
  };

  const ph = root.querySelector('#conditionPH');
  const temp = root.querySelector('#conditionTemp');
  const phValue = root.querySelector('#conditionPHValue');
  const tempValue = root.querySelector('#conditionTempValue');
  const meter = root.querySelector('#conditionMeter');
  const fill = root.querySelector('#conditionMeterFill');
  const status = root.querySelector('#conditionStatus');
  const explanation = root.querySelector('#conditionExplanation');
  const phText = root.querySelector('#conditionPHText');
  const tempText = root.querySelector('#conditionTempText');
  const enzymeName = root.querySelector('#conditionEnzymeName');
  const optPH = root.querySelector('#conditionOptPH');
  const where = root.querySelector('#conditionWhere');
  const graphCurve = root.querySelector('#temperatureActivityCurve');
  const graphDot = root.querySelector('#temperatureActivityDot');
  const graphGuide = root.querySelector('#temperatureActivityGuide');
  const graphCaption = root.querySelector('#temperatureGraphCaption');
  let selected = 'pepsin';

  function clamp(n, min, max){ return Math.max(min, Math.min(max, n)); }

  function update(){
    const enzyme = enzymes[selected];
    const p = Number(ph.value);
    const t = Number(temp.value);
    phValue.textContent = p.toFixed(1);
    tempValue.textContent = t + '°C';
    enzymeName.textContent = enzyme.name + ' activity';
    optPH.textContent = enzyme.phLabel;
    where.textContent = enzyme.where;
    phText.textContent = enzyme.phText;

    // Simplified pH model: activity falls as pH moves away from the enzyme's optimum.
    const phDistance = Math.abs(p - enzyme.ph);
    let phActivity = Math.exp(-0.5 * Math.pow(phDistance / 1.6, 2));
    // For pepsin, neutral and alkaline pH are far outside its strongly acidic working range.
    // Treat the tiny tail of the model curve as zero rather than suggesting meaningful activity.
    if (selected === 'pepsin' && p >= 7) phActivity = 0;
    const phUnsuitable = phActivity < 0.2;

    // Activity rises toward body temperature, then falls sharply as heat denatures the enzyme.
    let tempActivity;
    if (t <= 37) {
      tempActivity = 0.25 + 0.75 * (t / 37);
      tempText.textContent = t < 37
        ? 'In the cold, the enzyme and substrate move more slowly, so they meet less often. The enzyme usually keeps its shape.'
        : 'Around body temperature, this human enzyme can work efficiently.';
    } else {
      tempActivity = Math.exp(-Math.pow((t - 37) / 13, 2) * 1.7);
      tempText.textContent = t <= 45
        ? 'As temperature rises above the usual optimum, activity begins to fall.'
        : 'If it gets too hot, the enzyme can change shape. The substrate may no longer fit into the active site.';
    }

    const activity = Math.round(clamp(phActivity * tempActivity * 100, 0, 100));
    fill.style.width = activity + '%';
    meter.setAttribute('aria-valuenow', activity);
    let heading;
    let detail;
    if (t >= 60) {
      heading = 'Very low activity — likely denatured';
      detail = 'The temperature is very high. The enzyme’s structure can change, so its active site may no longer fit the substrate. Cooling it again may not restore the original shape.';
    } else if (phActivity < 0.05) {
      heading = 'Almost no activity — unsuitable pH';
      detail = selected === 'pepsin'
        ? 'Pepsin works best at about pH 2. At pH ' + p.toFixed(1) + ', which is neutral or alkaline, pepsin has almost no activity. The pH can disrupt the bonds that help maintain its active-site shape, so the substrate cannot bind effectively.'
        : 'This pH is far from this enzyme’s optimum (' + enzyme.phLabel + '). Its active site may change shape, so the substrate cannot bind effectively.';
    } else if (activity >= 75) {
      heading = 'High activity';
      detail = 'These conditions suit the enzyme, so the substrate can fit into its active site.';
    } else if (activity >= 40) {
      heading = 'Moderate activity';
      detail = 'The enzyme can still work, but the conditions are not ideal. Fewer enzyme-substrate complexes form in a given time.';
    } else if (t < 15) {
      heading = 'Low activity — too cold';
      detail = 'The enzyme and substrate move more slowly, so they collide less often. The enzyme usually keeps its shape and can become more active when warmed.';
    } else {
      heading = 'Low activity — unsuitable pH or temperature';
      detail = 'The pH or temperature is not right for this enzyme, so the substrate does not fit as easily.';
    }
    status.textContent = heading;
    explanation.textContent = detail + ' Estimated relative activity: ' + activity + '%.';

    // Show what happens to the selected enzyme as its temperature changes.
    const sceneTitle = root.querySelector('#sceneTitle');
    const sceneDescription = root.querySelector('#sceneDescription');
    const sceneTempLabel = root.querySelector('#sceneTempLabel');
    const enzymeShape = root.querySelector('#enzymeShape');
    const activeSite = root.querySelector('#activeSite');
    const substrateShape = root.querySelector('#substrateShape');
    if (sceneTitle && enzymeShape && activeSite && substrateShape) {
      sceneTitle.textContent = 'What happens to ' + enzyme.name + '?';
      let shapePath, sitePath, sceneText, sceneLabel, enzymeFill, enzymeStroke;
      if (t >= 60) {
        shapePath = 'M62 88 C48 58 94 43 111 65 C130 30 156 63 173 50 C206 43 216 91 188 105 C221 132 175 166 151 143 C122 170 92 137 83 145 C52 142 45 111 62 88 Z';
        sitePath = 'M162 68 Q145 84 164 96 Q145 111 163 126';
        sceneText = 'It is too hot. The enzyme changes shape, which means the substrate may no longer fit. This is called denaturation.';
        sceneLabel = t + '°C · active site changed (denatured)';
        enzymeFill = '#c98b83'; enzymeStroke = '#87433c';
      } else if (phUnsuitable) {
        shapePath = 'M62 88 C48 58 94 43 111 65 C130 30 156 63 173 50 C206 43 216 91 188 105 C221 132 175 166 151 143 C122 170 92 137 83 145 C52 142 45 111 62 88 Z';
        sitePath = 'M162 68 Q145 84 164 96 Q145 111 163 126';
        sceneText = selected === 'pepsin' && p > enzyme.ph
          ? 'Pepsin works best at about pH 2. At pH ' + p.toFixed(1) + ', the conditions are much less acidic than its optimum, so pepsin has almost no activity and the substrate cannot bind effectively.'
          : 'The pH is far from this enzyme’s usual optimum (' + enzyme.phLabel + '). Very acidic or alkaline conditions can disrupt bonds that help maintain its shape, changing the active site so the substrate may no longer fit.';
        sceneLabel = 'pH ' + p.toFixed(1) + ' · substrate no longer fits';
        enzymeFill = '#c98b83'; enzymeStroke = '#87433c';
      } else if (t > 42) {
        shapePath = 'M65 92 C65 48 105 43 130 59 C151 36 199 53 194 88 C218 110 192 151 160 145 C137 165 91 150 91 132 C70 130 57 113 65 92 Z';
        sitePath = 'M169 75 Q151 88 169 103';
        sceneText = "The temperature is above the enzyme's best range, so it is becoming less active. If it gets too hot, its shape can change.";
        sceneLabel = t + '°C · activity falling';
        enzymeFill = '#d9ad70'; enzymeStroke = '#8b642c';
      } else if (t < 15) {
        shapePath = 'M65 92 C65 48 105 43 130 59 C151 36 199 53 194 88 C218 110 192 151 160 145 C137 165 91 150 91 132 C70 130 57 113 65 92 Z';
        sitePath = 'M169 75 Q151 88 169 103';
        sceneText = 'When it is cold, the enzyme keeps its shape, but it works more slowly because the enzyme and substrate move around less.';
        sceneLabel = t + '°C · same shape, slower reaction';
        enzymeFill = '#80b7a5'; enzymeStroke = '#245d51';
      } else {
        shapePath = 'M65 92 C65 48 105 43 130 59 C151 36 199 53 194 88 C218 110 192 151 160 145 C137 165 91 150 91 132 C70 130 57 113 65 92 Z';
        sitePath = 'M169 75 Q151 88 169 103';
        sceneText = 'At this temperature, the enzyme is working well. The substrate can fit into the active site, so the reaction happens faster.';
        sceneLabel = t + '°C · substrate can fit';
        enzymeFill = '#80b7a5'; enzymeStroke = '#245d51';
      }
      enzymeShape.setAttribute('d', shapePath);
      enzymeShape.setAttribute('fill', enzymeFill);
      enzymeShape.setAttribute('stroke', enzymeStroke);
      activeSite.setAttribute('d', sitePath);
      activeSite.setAttribute('stroke', enzymeStroke);
      substrateShape.style.transform = (t >= 60 || phUnsuitable ? 'translate(0px, 18px) rotate(20deg)' : 'translate(0, 0)');
      substrateShape.style.transformOrigin = '390px 98px';
      sceneDescription.textContent = sceneText;
      sceneTempLabel.textContent = sceneLabel;
    }

    // Draw the temperature-response curve for the selected enzyme at the chosen pH.
    if (graphCurve && graphDot && graphGuide) {
      const points = [];
      for (let degree = 0; degree <= 80; degree += 2) {
        let curveTemp;
        if (degree <= 37) {
          curveTemp = 0.25 + 0.75 * (degree / 37);
        } else {
          curveTemp = Math.exp(-Math.pow((degree - 37) / 13, 2) * 1.7);
        }
        const curveActivity = clamp(phActivity * curveTemp * 100, 0, 100);
        const x = 30 + (degree / 80) * 275;
        const y = 122 - (curveActivity / 100) * 112;
        points.push(x.toFixed(1) + ',' + y.toFixed(1));
      }
      graphCurve.setAttribute('points', points.join(' '));
      const markerX = 30 + (t / 80) * 275;
      const markerY = 122 - (activity / 100) * 112;
      graphDot.setAttribute('cx', markerX.toFixed(1));
      graphDot.setAttribute('cy', markerY.toFixed(1));
      graphGuide.setAttribute('x1', markerX.toFixed(1));
      graphGuide.setAttribute('x2', markerX.toFixed(1));
      if (graphCaption) {
        graphCaption.textContent = 'At ' + t + '°C and pH ' + p.toFixed(1) + ': estimated activity is ' + activity + '%.';
      }
    }
  }

  root.querySelectorAll('[data-enzyme]').forEach(function(button){
    button.addEventListener('click', function(){
      selected = button.getAttribute('data-enzyme');
      root.querySelectorAll('[data-enzyme]').forEach(function(other){
        other.setAttribute('aria-pressed', String(other === button));
      });
      ph.value = enzymes[selected].ph;
      temp.value = 37;
      update();
    });
  });
  ph.addEventListener('input', update);
  temp.addEventListener('input', update);
  update();
})();
</script>

